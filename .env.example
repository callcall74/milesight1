# Upstash Redis (Vercel Marketplace에서 Upstash 연결 시 KV_REST_API_URL / KV_REST_API_TOKEN 이 자동 주입됨)
# 비워두면 로컬 개발용 메모리 저장소를 사용합니다 (재시작 시 사라짐).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 카메라 수신 인증 (카메라 Post 설정의 User Name / Password 와 동일하게)
INGEST_USER=
INGEST_PASSWORD=
# Basic 인증 대신 URL 토큰을 쓰고 싶으면: https://도메인/api/milesight?key=값
INGEST_TOKEN=

# 대시보드 접근 비밀번호 (비워두면 누구나 접근 가능)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# 스냅샷 이미지 보관 시간(시간 단위, 기본 24)
SNAPSHOT_TTL_HOURS=24
